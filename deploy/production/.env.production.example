# Public edge. TierHive HAProxy should forward both hosts to this port. The
# apex serves only the public site/docs and OTLP; the console host requires OAuth.
GLASSBOX_PUBLIC_DOMAIN=glassboxhq.xyz
GLASSBOX_CONSOLE_DOMAIN=app.glassboxhq.xyz
GLASSBOX_EDGE_PORT=8080
GLASSBOX_IMAGE_TAG=rc1
GLASSBOX_ORGANIZATION=glassbox-demo
GLASSBOX_ADMIN_EMAILS=admin@example.com

# GitHub OAuth App registered with callback:
# https://app.glassboxhq.xyz/oauth2/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Any GitHub user may sign in as a read-only viewer. Only these comma-separated
# usernames receive administrator mutations such as connection or key changes.
GITHUB_ADMIN_USERS=your-github-username

# Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH_COOKIE_SECRET=

# Generate with: glassbox-control master-key
GLASSBOX_CONTROL_MASTER_KEY=
GLASSBOX_CONTROL_MASTER_KEY_ID=control-v1

# Generate each value independently with at least 32 random bytes.
GLASSBOX_CONTROL_API_TOKEN=
GLASSBOX_FORENSICS_API_TOKEN=
GLASSBOX_POSTGRES_PASSWORD=

# Receipt authority. Generate the private key and matching trusted-signers file
# through the GlassBox signer tooling; never commit either deployment artifact.
GLASSBOX_RECEIPT_SIGNING_KEY_ID=
GLASSBOX_RECEIPT_SIGNING_KEY=
GLASSBOX_SIGNER_TRUST_POLICY_PATH=
GLASSBOX_STATE_POSTGRES_SCHEMA=glassbox
