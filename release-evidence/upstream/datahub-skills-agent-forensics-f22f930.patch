+"""Deterministic safety tests for bundled Agent Forensics helpers."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+import unittest
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+SKILL_ROOT = REPO_ROOT / "skills" / "datahub-agent-forensics"
+
+
+class InspectReceiptTests(unittest.TestCase):
+    def test_document_projection_is_non_authoritative_and_allowlisted(self) -> None:
+        fixture = SKILL_ROOT / "evaluations" / "fixtures" / "document-projection.json"
+        script = SKILL_ROOT / "scripts" / "inspect_receipt.py"
+
+        completed = subprocess.run(
+            [sys.executable, str(script), str(fixture)],
+            check=True,
+            capture_output=True,
+            text=True,
+        )
+
+        report = json.loads(completed.stdout)
+        self.assertEqual(report["integrity"]["status"], "PROJECTION_ONLY")
+        self.assertFalse(report["safe_for_deterministic_policy"])
+        self.assertEqual(report["ignored_property_count"], 1)
+        self.assertNotIn("MUST_NOT_APPEAR", completed.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
