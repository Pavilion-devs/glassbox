{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassbox.dev/schemas/state-transfer/0.1.0/schema.json",
  "title": "GlassBox state transfer bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "bundle_id",
    "source",
    "receipts",
    "operational_archive",
    "integrity"
  ],
  "properties": {
    "spec_version": { "const": "0.1.0" },
    "bundle_id": {
      "type": "string",
      "pattern": "^gbx:state-transfer:sha256:[0-9a-f]{64}$"
    },
    "source": { "$ref": "#/$defs/source" },
    "receipts": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/receiptTransfer" }
    },
    "operational_archive": { "$ref": "#/$defs/operationalArchive" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "public_key", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "public_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipts",
        "dependencies",
        "campaigns",
        "audit_records",
        "owner_routing_tasks",
        "receipt_publication_tasks"
      ],
      "properties": {
        "receipts": { "type": "integer", "minimum": 0 },
        "dependencies": { "type": "integer", "minimum": 0 },
        "campaigns": { "type": "integer", "minimum": 0 },
        "audit_records": { "type": "integer", "minimum": 0 },
        "owner_routing_tasks": { "type": "integer", "minimum": 0 },
        "receipt_publication_tasks": { "type": "integer", "minimum": 0 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "schema_version",
        "integrity_verified",
        "import_scope",
        "counts"
      ],
      "properties": {
        "engine": { "enum": ["SQLITE", "POSTGRESQL"] },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "integrity_verified": { "const": true },
        "import_scope": { "const": "RECEIPTS_ONLY" },
        "counts": { "$ref": "#/$defs/counts" }
      }
    },
    "fieldLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "rule_id", "wildcard_query"],
      "properties": {
        "coverage": { "enum": ["NONE", "PARTIAL", "COMPLETE"] },
        "rule_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
        "wildcard_query": { "type": ["boolean", "null"] }
      }
    },
    "receiptTransfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "field_lineage", "superseded_by"],
      "properties": {
        "receipt": { "type": "object" },
        "field_lineage": { "$ref": "#/$defs/fieldLineage" },
        "superseded_by": {
          "type": ["string", "null"],
          "pattern": "^gbx:receipt:sha256:[0-9a-f]{64}$"
        }
      }
    },
    "archivedRecord": {
      "type": "object",
      "maxProperties": 24
    },
    "operationalArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activated_on_import",
        "receipt_publication_tasks",
        "campaign_tasks",
        "owner_routing_tasks",
        "audit_records"
      ],
      "properties": {
        "activated_on_import": { "const": false },
        "receipt_publication_tasks": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/archivedRecord" }
        },
        "campaign_tasks": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/archivedRecord" }
        },
        "owner_routing_tasks": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/archivedRecord" }
        },
        "audit_records": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/archivedRecord" }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "payload_digest", "signatures"],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "payload_digest": { "$ref": "#/$defs/digest" },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/signature" }
        }
      }
    }
  }
}
