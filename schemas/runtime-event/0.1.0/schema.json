{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassbox.dev/schemas/runtime-event/0.1.0/schema.json",
  "title": "GlassBox normalized runtime event 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "sequence",
    "occurred_at",
    "kind",
    "trace_id",
    "span_id",
    "parent_span_id",
    "run_id",
    "parent_run_id",
    "agent.id",
    "agent.version",
    "workflow.id",
    "workflow.version",
    "attributes"
  ],
  "properties": {
    "spec_version": { "const": "0.1.0" },
    "sequence": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "kind": {
      "enum": [
        "glassbox.run.started",
        "glassbox.run.finished",
        "glassbox.evidence.observed",
        "glassbox.action.attempted",
        "glassbox.action.finished"
      ]
    },
    "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "span_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "parent_span_id": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        { "type": "null" }
      ]
    },
    "run_id": { "type": "string", "minLength": 1 },
    "parent_run_id": { "type": ["string", "null"], "minLength": 1 },
    "agent.id": { "type": "string", "minLength": 1 },
    "agent.version": { "type": ["string", "null"], "minLength": 1 },
    "workflow.id": { "type": "string", "minLength": 1 },
    "workflow.version": { "type": ["string", "null"], "minLength": 1 },
    "attributes": { "type": "object" }
  },
  "$defs": {
    "digestOrNull": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableString": { "type": ["string", "null"], "minLength": 1 },
    "metadata": { "type": "object" },
    "actionAttributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool.id",
        "action.effect",
        "action.status",
        "action.input_digest",
        "action.output_digest",
        "action.idempotency_key",
        "action.approval_id",
        "error.type",
        "metadata"
      ],
      "properties": {
        "tool.id": { "type": "string", "minLength": 1 },
        "action.effect": {
          "enum": ["READ_ONLY", "REVERSIBLE", "IRREVERSIBLE", "UNKNOWN_EFFECT"]
        },
        "action.status": {
          "enum": ["ATTEMPTED", "SUCCEEDED", "FAILED", "BLOCKED"]
        },
        "action.input_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "action.output_digest": { "$ref": "#/$defs/digestOrNull" },
        "action.idempotency_key": { "$ref": "#/$defs/nullableString" },
        "action.approval_id": { "$ref": "#/$defs/nullableString" },
        "error.type": { "$ref": "#/$defs/nullableString" },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "glassbox.run.started" } } },
      "then": {
        "properties": {
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["run.status"],
            "properties": { "run.status": { "const": "STARTED" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "glassbox.run.finished" } } },
      "then": {
        "properties": {
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["run.status", "output.digest", "error.type"],
            "properties": {
              "run.status": { "enum": ["SUCCEEDED", "FAILED", "ABSTAINED", "CANCELLED"] },
              "output.digest": { "$ref": "#/$defs/digestOrNull" },
              "error.type": { "$ref": "#/$defs/nullableString" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "glassbox.evidence.observed" } } },
      "then": {
        "properties": {
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence.entity_type",
              "datahub.urn",
              "datahub.schema_field_urn",
              "evidence.state",
              "evidence.role",
              "evidence.representation_digest",
              "evidence.capture_method",
              "evidence.rule_id",
              "evidence.confidence",
              "metadata"
            ],
            "properties": {
              "evidence.entity_type": { "type": "string", "minLength": 1 },
              "evidence.source_span_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              },
              "datahub.urn": { "$ref": "#/$defs/nullableString" },
              "datahub.schema_field_urn": { "$ref": "#/$defs/nullableString" },
              "evidence.state": { "enum": ["OBSERVED", "DECLARED", "INFERRED", "UNKNOWN"] },
              "evidence.role": {
                "enum": ["INPUT", "REFERENCE", "CONSTRAINT", "POLICY", "MEMORY", "OUTPUT_TARGET"]
              },
              "evidence.representation_digest": { "$ref": "#/$defs/digestOrNull" },
              "evidence.capture_method": { "type": "string", "minLength": 1 },
              "evidence.rule_id": { "$ref": "#/$defs/nullableString" },
              "evidence.confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "metadata": { "$ref": "#/$defs/metadata" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "evidence.state": { "const": "OBSERVED" } },
                  "required": ["evidence.state"]
                },
                "then": {
                  "properties": {
                    "evidence.representation_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": { "evidence.state": { "const": "INFERRED" } },
                  "required": ["evidence.state"]
                },
                "then": {
                  "properties": {
                    "evidence.rule_id": { "type": "string", "minLength": 1 },
                    "evidence.confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "glassbox.action.attempted" } } },
      "then": {
        "properties": {
          "attributes": {
            "allOf": [
              { "$ref": "#/$defs/actionAttributes" },
              {
                "properties": {
                  "action.status": { "const": "ATTEMPTED" },
                  "action.output_digest": { "type": "null" },
                  "error.type": { "type": "null" }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "glassbox.action.finished" } } },
      "then": {
        "properties": {
          "attributes": {
            "allOf": [
              { "$ref": "#/$defs/actionAttributes" },
              { "properties": { "action.status": { "enum": ["SUCCEEDED", "FAILED", "BLOCKED"] } } },
              {
                "if": {
                  "properties": { "action.status": { "const": "SUCCEEDED" } },
                  "required": ["action.status"]
                },
                "then": {
                  "properties": {
                    "action.output_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "error.type": { "type": "null" }
                  }
                }
              },
              {
                "if": {
                  "properties": { "action.status": { "const": "FAILED" } },
                  "required": ["action.status"]
                },
                "then": {
                  "properties": { "error.type": { "type": "string", "minLength": 1 } }
                }
              },
              {
                "if": {
                  "properties": { "action.status": { "const": "BLOCKED" } },
                  "required": ["action.status"]
                },
                "then": {
                  "properties": { "action.output_digest": { "type": "null" } }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
