{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassbox.dev/schemas/semantic-policy/0.1.0/schema.json",
  "title": "GlassBox Deterministic Semantic Policy",
  "description": "Content-addressed declarative rules for deterministic replay-output equivalence without executable policy code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "spec_version",
    "policy_id",
    "name",
    "version",
    "output_kind",
    "rules",
    "raw_content_returned"
  ],
  "properties": {
    "contract": { "const": "glassbox.semantic-policy.v1" },
    "spec_version": { "const": "0.1.0" },
    "policy_id": {
      "type": "string",
      "pattern": "^gbx:semantic-policy:sha256:[0-9a-f]{64}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "output_kind": { "type": "string", "minLength": 1, "maxLength": 128 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/rule" }
    },
    "raw_content_returned": { "const": false }
  },
  "$defs": {
    "nullableDecimal": {
      "oneOf": [
        { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
        { "type": "null" }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "kind",
        "path",
        "absolute_tolerance",
        "relative_tolerance"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "kind": {
          "enum": ["NUMERIC_TOLERANCE", "UNORDERED_COLLECTION"]
        },
        "path": { "type": "string", "maxLength": 512 },
        "absolute_tolerance": { "$ref": "#/$defs/nullableDecimal" },
        "relative_tolerance": { "$ref": "#/$defs/nullableDecimal" }
      }
    }
  }
}
