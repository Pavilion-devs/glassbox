{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassbox.dev/schemas/replay-bundle/0.1.0/schema.json",
  "title": "GlassBox Replay Bundle",
  "description": "Content-addressed, digest-only recipe for planning a controlled replay without overwriting its source receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "bundle_id",
    "source",
    "mode",
    "recipe",
    "execution",
    "context",
    "original_output",
    "integrity"
  ],
  "properties": {
    "spec_version": { "const": "0.1.0" },
    "bundle_id": {
      "type": "string",
      "pattern": "^gbx:replay-bundle:sha256:[0-9a-f]{64}$"
    },
    "source": { "$ref": "#/$defs/source" },
    "mode": { "enum": ["PINNED", "CORRECTED", "COUNTERFACTUAL", "DRY"] },
    "recipe": { "$ref": "#/$defs/recipe" },
    "execution": { "$ref": "#/$defs/execution" },
    "context": {
      "type": "array",
      "items": { "$ref": "#/$defs/context" }
    },
    "original_output": { "$ref": "#/$defs/output" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nullableString": { "type": ["string", "null"] },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "nullableDigest": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "payload_digest", "replay_eligibility"],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^gbx:receipt:sha256:[0-9a-f]{64}$"
        },
        "payload_digest": { "$ref": "#/$defs/digest" },
        "replay_eligibility": {
          "enum": [
            "ELIGIBLE",
            "REQUIRES_APPROVAL",
            "DRY_RUN_ONLY",
            "UNREPLAYABLE",
            "NOT_EVALUATED"
          ]
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source_digest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nullableString" },
        "source_digest": { "$ref": "#/$defs/nullableDigest" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nullableString" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source_digest", "schema_digest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nullableString" },
        "source_digest": { "$ref": "#/$defs/nullableDigest" },
        "schema_digest": { "$ref": "#/$defs/nullableDigest" }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "language", "statement_digest", "redacted"],
      "properties": {
        "query_id": { "$ref": "#/$defs/nonEmptyString" },
        "language": { "$ref": "#/$defs/nonEmptyString" },
        "statement_digest": { "$ref": "#/$defs/digest" },
        "redacted": { "type": "boolean" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "tool_id",
        "effect",
        "status",
        "idempotency_key",
        "input_digest",
        "output_digest",
        "approval_id",
        "action_digest"
      ],
      "properties": {
        "action_id": { "$ref": "#/$defs/nonEmptyString" },
        "tool_id": { "$ref": "#/$defs/nonEmptyString" },
        "effect": {
          "enum": ["READ_ONLY", "REVERSIBLE", "IRREVERSIBLE", "UNKNOWN_EFFECT"]
        },
        "status": { "enum": ["PLANNED", "ATTEMPTED", "SUCCEEDED", "FAILED", "BLOCKED"] },
        "idempotency_key": { "$ref": "#/$defs/nullableString" },
        "input_digest": { "$ref": "#/$defs/digest" },
        "output_digest": { "$ref": "#/$defs/nullableDigest" },
        "approval_id": { "$ref": "#/$defs/nullableString" },
        "original_input_digest": { "$ref": "#/$defs/digest" },
        "input_origin": { "const": "CONTEXT_REPLACEMENT" },
        "input_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "input_verification_authority": { "$ref": "#/$defs/nonEmptyString" },
        "action_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "agent",
        "workflow",
        "models",
        "skills",
        "tools",
        "queries",
        "actions"
      ],
      "properties": {
        "environment": { "$ref": "#/$defs/nonEmptyString" },
        "agent": { "$ref": "#/$defs/component" },
        "workflow": { "$ref": "#/$defs/workflow" },
        "models": { "type": "array", "items": { "$ref": "#/$defs/component" } },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/component" } },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
        "queries": { "type": "array", "items": { "$ref": "#/$defs/query" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      }
    },
    "modelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "provider_id",
        "parameters_digest",
        "determinism",
        "verification_authority"
      ],
      "properties": {
        "model_id": { "$ref": "#/$defs/nonEmptyString" },
        "provider_id": { "$ref": "#/$defs/nonEmptyString" },
        "parameters_digest": { "$ref": "#/$defs/digest" },
        "determinism": { "enum": ["DETERMINISTIC", "NONDETERMINISTIC", "UNKNOWN"] },
        "verification_authority": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_digest",
        "input_reference",
        "feature_flags_digest",
        "model_configs"
      ],
      "properties": {
        "input_digest": { "$ref": "#/$defs/nullableDigest" },
        "input_reference": { "$ref": "#/$defs/nullableString" },
        "feature_flags_digest": { "$ref": "#/$defs/nullableDigest" },
        "model_configs": {
          "type": "array",
          "items": { "$ref": "#/$defs/modelConfig" }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "datahub_urn",
        "schema_field_urn",
        "state",
        "role",
        "original_representation_digest",
        "active_representation_digest",
        "origin",
        "verification_authority"
      ],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/nonEmptyString" },
        "datahub_urn": { "$ref": "#/$defs/nullableString" },
        "schema_field_urn": { "$ref": "#/$defs/nullableString" },
        "state": { "enum": ["OBSERVED", "DECLARED", "INFERRED", "UNKNOWN"] },
        "role": {
          "enum": ["INPUT", "REFERENCE", "CONSTRAINT", "POLICY", "MEMORY", "OUTPUT_TARGET"]
        },
        "original_representation_digest": { "$ref": "#/$defs/nullableDigest" },
        "active_representation_digest": { "$ref": "#/$defs/nullableDigest" },
        "origin": { "enum": ["ORIGINAL_RECEIPT", "CONTEXT_REPLACEMENT"] },
        "verification_authority": { "$ref": "#/$defs/nullableString" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mime_type", "digest"],
      "properties": {
        "kind": { "$ref": "#/$defs/nonEmptyString" },
        "mime_type": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "public_key", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "$ref": "#/$defs/nonEmptyString" },
        "public_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "payload_digest", "signatures"],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "payload_digest": { "$ref": "#/$defs/digest" },
        "signatures": { "type": "array", "items": { "$ref": "#/$defs/signature" } }
      }
    }
  }
}
