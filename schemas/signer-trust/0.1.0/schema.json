{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassbox.dev/schemas/signer-trust/0.1.0/schema.json",
  "title": "GlassBox trusted receipt signer policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "minimum_trusted_signatures",
    "signers"
  ],
  "properties": {
    "schema_version": {
      "const": "glassbox.signer-trust.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "minimum_trusted_signatures": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "signers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/signer"
      }
    }
  },
  "$defs": {
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "public_key",
        "public_key_sha256",
        "status",
        "not_before",
        "not_after"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "public_key_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": ["ACTIVE", "RETIRED", "REVOKED"]
        },
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "not_after": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
