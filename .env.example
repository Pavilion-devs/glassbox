# DataHub Core defaults. Never place a real token in this file.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=

# Live mutation is opt-in in every GlassBox integration command.
GLASSBOX_ALLOW_LIVE_PROBE=false

# Optional multi-host invalidation state. Replace this synthetic local placeholder;
# production deployments should inject the value through a secret manager.
GLASSBOX_STATE_POSTGRES_DSN=postgresql://glassbox:synthetic-local-only@localhost:5432/glassbox

# OTLP receiver secrets are environment-indirect. Leave blank in source control.
GLASSBOX_RECEIPT_SIGNING_KEY=
GLASSBOX_OTLP_BEARER_TOKEN=
# Public-key trust policy path. The file is not a private key, but modification is a
# security-sensitive operator action.
GLASSBOX_SIGNER_TRUST_POLICY_PATH=

# Read-only loopback API exposed by `glassbox-forensics-mcp --transport streamable-http`.
# The console never receives database credentials or signing keys.
GLASSBOX_FORENSICS_API_URL=http://127.0.0.1:8788
GLASSBOX_FORENSICS_API_TOKEN=

# Authenticated deployment control plane. The master key must be an unpadded
# base64url-encoded 32-byte value and must come from a secret manager.
GLASSBOX_CONTROL_API_URL=http://127.0.0.1:8790
GLASSBOX_CONTROL_API_TOKEN=
GLASSBOX_CONTROL_MASTER_KEY=
GLASSBOX_CONTROL_MASTER_KEY_ID=control-v1
GLASSBOX_CONTROL_DB_PATH=.glassbox/control.sqlite3
GLASSBOX_ORGANIZATION=default

# Human authorization is derived from an upstream OIDC identity. This explicit
# local bypass must remain false in an internet deployment.
GLASSBOX_ADMIN_EMAILS=
GLASSBOX_ALLOW_LOCAL_OPERATOR=false

# Optional public-site hosts. Hosts listed here receive the landing page at `/`
# and never expose operator routes. Leave empty for a console-only self-hosted install.
GLASSBOX_PUBLIC_HOSTS=
